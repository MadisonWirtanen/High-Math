# 复制此文件为 .env.local 后修改（可选，桌面版可直接在界面里配置）
#
# 配置优先级：环境变量 > 配置文件 > 内置默认值
# 桌面版一般无需本文件 —— 打开应用后进「设置」页选择目录即可。

# ===== 题库位置 =====
# 题库根目录（Obsidian Vault 模式填 Vault 根目录；直接题库模式填题库目录本身）
VAULT_PATH=./demo-vault
# 题目所在子目录名，'.' 表示 VAULT_PATH 本身就是题库目录
BANK_DIR_NAME=题库
# 图片子目录名
IMAGES_DIR_NAME=images

# ===== 学段与分类 =====
DEFAULT_GRADE=高中
GRADE_LIST=初中,高中
SUBJECT_SUFFIX=数学

# ===== 可选依赖 =====
# Pandoc 可执行文件路径（留空自动探测）
# PANDOC_PATH=D:\tool\pandoc-3.10\pandoc.exe
# 知识点总表路径（留空自动在题库目录 / Vault 根目录查找）
# KNOWLEDGE_TABLE_PATH=D:\高中数学\高中数学知识点总表.md

# ===== 服务 =====
# PORT=3000
